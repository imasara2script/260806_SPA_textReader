{
  "name": "ログファイルビューアー",
  "short_name": "LogViewer",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#007bff",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "log_file",
          "accept": ["text/plain", ".txt", ".log"]
        }
      ]
    }
  }
}